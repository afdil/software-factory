{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Software Factory Task DAG Schema",
  "type": "object",
  "required": [
    "project_slug",
    "project_type",
    "template",
    "needs_grill",
    "needs_mockup",
    "modules"
  ],
  "properties": {
    "project_slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "project_type": {
      "type": "string",
      "enum": ["saas", "landing", "service"]
    },
    "template": {
      "type": "string",
      "enum": ["tpl-saas-rust-vue", "tpl-landing-nuxt", "tpl-service-rust"]
    },
    "needs_grill": {
      "type": "boolean"
    },
    "needs_mockup": {
      "type": "boolean"
    },
    "max_parallel_workers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 3
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "tasks"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^M[0-9]+$"
          },
          "name": {
            "type": "string"
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title",
                "owner",
                "depends_on",
                "parallel_safe",
                "file_scope",
                "verify_cmd",
                "acceptance_criteria",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^(BE|FE|QA|SEC|OPS)-M[0-9]+-[0-9]+$"
                },
                "title": {
                  "type": "string"
                },
                "owner": {
                  "type": "string",
                  "enum": ["rust-dev", "vue-dev", "qa-tester", "satpam", "devops"]
                },
                "effort": {
                  "type": "string",
                  "enum": ["low", "medium", "high", "xhigh"],
                  "default": "medium"
                },
                "depends_on": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "parallel_safe": {
                  "type": "boolean",
                  "description": "True only when file_scope does not touch shared wiring files or overlap with sibling parallel tasks."
                },
                "file_scope": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "verify_cmd": {
                  "type": "string"
                },
                "acceptance_criteria": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string" }
                },
                "status": {
                  "type": "string",
                  "enum": ["pending", "in_progress", "done", "blocked"]
                },
                "retries": {
                  "type": "integer",
                  "minimum": 0,
                  "default": 0
                },
                "max_retries": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 3,
                  "default": 3
                }
              }
            }
          }
        }
      }
    }
  }
}
