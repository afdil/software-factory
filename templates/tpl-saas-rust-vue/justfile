set dotenv-load := true
set windows-shell := ["cmd.exe", "/c"]

# Start local PostgreSQL for development and testing
db-up:
    docker compose -f docker-compose.dev.yml up -d --wait

# Stop local PostgreSQL
db-down:
    docker compose -f docker-compose.dev.yml down

# Reset local PostgreSQL data volume cleanly
db-reset:
    docker compose -f docker-compose.dev.yml down -v
    docker compose -f docker-compose.dev.yml up -d --wait

# Backend quality gate (format, strict clippy, unit + integration tests)
be-check:
    cargo fmt --manifest-path backend/Cargo.toml -- --check
    cargo clippy --manifest-path backend/Cargo.toml --all-targets -- -D warnings
    cargo test --manifest-path backend/Cargo.toml

# Export OpenAPI JSON from Rust and generate TypeScript client types for Vue
gen-api:
    cargo run --manifest-path backend/Cargo.toml --bin export_openapi
    pnpm --dir frontend run gen:api

# Frontend quality gate (lint, typecheck, production bundle)
fe-check:
    pnpm --dir frontend run typecheck
    pnpm --dir frontend run build

# Run Playwright E2E smoke & feature tests
e2e:
    pnpm --dir e2e test

# Full verification gate before QA / security / deploy
verify-all: be-check gen-api fe-check

# Local dev servers
dev-be:
    cargo run --manifest-path backend/Cargo.toml

dev-fe:
    pnpm --dir frontend dev
